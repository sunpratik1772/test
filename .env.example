# ─────────────────────────────────────────────────────────────────────────────
# FX-FRO Surveillance — Environment Variables
# Copy this file to app/.env and fill in your values.
# NEVER commit app/.env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google AI Studio (recommended for local dev) ─────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=YOUR_PRIMARY_API_KEY

# Optional fallback keys for automatic rotation on quota exhaustion (429 errors)
# Add as many as you have (GOOGLE_API_KEY_2 through GOOGLE_API_KEY_9)
# GOOGLE_API_KEY_2=YOUR_SECOND_API_KEY
# GOOGLE_API_KEY_3=YOUR_THIRD_API_KEY

# ── Google Cloud Vertex AI (alternative) ─────────────────────────────────────
# Uncomment to use Vertex AI instead of AI Studio keys above.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
